<aside class="offcanvas-lg offcanvas-start app-sidebar diamond-sidebar" tabindex="-1" id="appSidebar" aria-labelledby="appSidebarLabel" data-bs-theme="dark">

    <!-- Marca -->
    <div class="diamond-heading">
        <a href="/" class="diamond-brand">
            <span class="diamond-brand-ball" aria-hidden="true">⚾</span>

            <span class="diamond-brand-copy">
                <strong id="appSidebarLabel">AL DIAMANTE</strong>
                <small>TU GENTE. TU JUEGO.</small>
            </span>
        </a>

        <button type="button" class="btn-close d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#appSidebar" aria-label="Cerrar menú"></button>
    </div>

    <div class="offcanvas-body p-0">
        <nav class="diamond-nav" aria-label="Navegación principal">

            <!-- Solo visible cuando exista un partido activo -->
            <a href="/games/live" class="diamond-live" id="sidebarLiveGame" hidden>
                <div class="diamond-live-top">
                    <span class="diamond-live-label">
                        <span class="diamond-live-dot" aria-hidden="true"></span>
                        PARTIDO EN VIVO
                    </span>

                    <i class="bi bi-broadcast" aria-hidden="true"></i>
                </div>

                <strong>¡El juego está encendido!</strong>
                <p>Entra al marcador y vive cada batazo.</p>

                <span class="diamond-live-action">
                    Entrar al partido
                    <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
                </span>
            </a>

            <div class="diamond-section">A jugar</div>

            <a href="/" class="diamond-link {{#if activeHome}}active{{/if}}">
                <span class="diamond-link-icon"><i class="bi bi-house-door-fill" aria-hidden="true"></i></span>
                <span>Inicio</span>
                <i class="bi bi-chevron-right diamond-link-arrow" aria-hidden="true"></i>
            </a>

            <a href="/games" class="diamond-link {{#if activeGames}}active{{/if}}">
                <span class="diamond-link-icon"><i class="bi bi-calendar-event" aria-hidden="true"></i></span>
                <span>Partidos</span>
                <i class="bi bi-chevron-right diamond-link-arrow" aria-hidden="true"></i>
            </a>

            <div class="diamond-section">Los protagonistas</div>

            <a href="/jugadores" class="diamond-link {{#if activePlayers}}active{{/if}}">
                <span class="diamond-link-icon"><i class="bi bi-person-badge" aria-hidden="true"></i></span>
                <span>Jugadores</span>
                <i class="bi bi-chevron-right diamond-link-arrow" aria-hidden="true"></i>
            </a>

            <a href="/teams" class="diamond-link {{#if activeTeams}}active{{/if}}">
                <span class="diamond-link-icon"><i class="bi bi-people-fill" aria-hidden="true"></i></span>
                <span>Equipos</span>
                <i class="bi bi-chevron-right diamond-link-arrow" aria-hidden="true"></i>
            </a>

            <div class="diamond-section">Los números del juego</div>

            <a href="/stats" class="diamond-link {{#if activeStats}}active{{/if}}">
                <span class="diamond-link-icon"><i class="bi bi-bar-chart-line-fill" aria-hidden="true"></i></span>
                <span>Estadísticas</span>
                <i class="bi bi-chevron-right diamond-link-arrow" aria-hidden="true"></i>
            </a>

            <a href="/standings" class="diamond-link {{#if activeStandings}}active{{/if}}">
                <span class="diamond-link-icon"><i class="bi bi-trophy-fill" aria-hidden="true"></i></span>
                <span>Posiciones</span>
                <i class="bi bi-chevron-right diamond-link-arrow" aria-hidden="true"></i>
            </a>

            <div class="diamond-footer">
                <i class="bi bi-diamond-fill" aria-hidden="true"></i>
                <div>
                    <strong>Que no te lo cuenten.</strong>
                    <span>Vive el próximo gran batazo.</span>
                </div>
            </div>

        </nav>
    </div>
</aside>